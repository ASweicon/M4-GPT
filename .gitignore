# Datasets (图片不入库; jsonl 是数据配置, 纳入版本控制)
data/*
!data/*.jsonl

# Training outputs (放行 LoRA adapter 目录, 供跨机器 --resume 续训)
outputs/*
!outputs/lora/

# Model weights (local cache) — adapter 权重精确放行
*.safetensors
*.bin
*.pt
*.pth
!outputs/lora/adapter_model.safetensors

# LMDB data
*.lmdb
*.mdb

# Python cache
__pycache__/
*.pyc
*.pyo

# IDE
.vscode/
.idea/

# macOS
.DS_Store

# Env
.env
*.log

# Large archives (never commit, use rsync/scp instead)
*.tar.gz
*.tar
*.zip
deploy/

# Server artifacts backup (eval results, adapters, training logs, dataset archives)
backup/
