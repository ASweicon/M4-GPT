# Datasets (图片不入库; jsonl 是数据配置, 纳入版本控制)
data/*
!data/*.jsonl

# Training outputs
outputs/

# Model weights (local cache)
*.safetensors
*.bin
*.pt
*.pth

# LMDB data
*.lmdb
*.mdb

# Python cache
__pycache__/
*.pyc
*.pyo

# IDE
.vscode/
.idea/

# macOS
.DS_Store

# Env
.env
*.log

# Large archives (never commit, use rsync/scp instead)
*.tar.gz
*.tar
*.zip
deploy/

# Server artifacts backup (eval results, adapters, training logs, dataset archives)
backup/
